# Gere uma chave longa; o painel pede esta chave no login.
ADMIN_TOKEN=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES
# IP ou dominio do LXC que o Proxmox consegue acessar.
HOST_ADDRESS=192.168.1.100
# Porta externa do painel/API. Pode mudar, por exemplo, para 8790.
PORT=8787
# URL derivada automaticamente. Para proxy HTTPS, substitua pela URL publica.
PUBLIC_URL=http://${HOST_ADDRESS}:${PORT}
# Restrinja ao IP de rede local do LXC quando possível.
BIND_IP=0.0.0.0
# Exige HTTPS se definido como 1 (recomendado com proxy reverso).
REQUIRE_HTTPS=0
# MQTT tem porta independente na URL, por exemplo mqtt://192.168.1.50:1883.
# Use mqtts://host:8883 para TLS. Tambem pode configurar pela interface.
# Deixe vazio para desativar a integracao ate configurar seu broker.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
